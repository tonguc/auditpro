# Beta defaults. Authentication will replace this with the subscribed organization plan.
AUDITPRO_DEFAULT_PLAN=free
AUDITPRO_DEPLOYMENT_MODE=production
AUDITPRO_PILOT_UNLIMITED_PAGES=false

# Production services to configure during deployment.
APP_DOMAIN=replace-with-production-hostname
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgresql://auditpro:change-me@localhost:5432/auditpro
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
AUDITPRO_SIGNUP_ENABLED=false
# Explicit public launch mode: no account, no payment, bounded analysis jobs.
AUDITPRO_PUBLIC_ANALYSIS_ENABLED=false
AUDITPRO_PUBLIC_PAGE_LIMIT=25
AUDITPRO_RENDERED_PAGE_LIMIT=5

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_POOL_SIZE=10
AUDITPRO_INLINE_ANALYSIS_JOBS=true
AUDITPRO_STALE_JOB_MS=1800000
AUDITPRO_WORKER_POLL_MS=2500
AUDITPRO_MIGRATION_LOCK_TIMEOUT_MS=30000
AUDITPRO_LAUNCH_READINESS_MAX_AGE_MS=86400000
AUDITPRO_BACKUP_MAX_AGE_MS=86400000
AUDITPRO_LOG_LEVEL=info
AUDITPRO_ADMIN_SECRET=replace-with-admin-health-secret
AUDITPRO_BILLING_SYNC_SECRET=replace-with-billing-webhook-secret
STRIPE_WEBHOOK_SECRET=whsec_replace
AUDITPRO_STRIPE_PRO_PRICE_ID=price_replace_pro
AUDITPRO_STRIPE_AGENCY_PRICE_ID=price_replace_agency
AUDITPRO_STRIPE_ENTERPRISE_PRICE_ID=price_replace_enterprise
AUDITPRO_ALLOW_SEED=false
AUDITPRO_ALLOW_PRODUCTION_SEED=false
AUDITPRO_ALLOW_REMOTE_SEED=false
AUDITPRO_DEMO_EMAIL=demo@auditpro.local
AUDITPRO_DEMO_ORG=AuditPro Demo
AUDITPRO_E2E_CLOUD_MOCK=false
AUDITPRO_E2E_CLOUD_MOCK_TOKEN=
AUDITPRO_REQUIRE_PDF_RENDER=false

# Optional integration test database. Use a disposable database/user.
AUDITPRO_INTEGRATION_DATABASE_URL=
AUDITPRO_ALLOW_REMOTE_INTEGRATION_DB=false

# Optional preflight DB connectivity check. Keep false for offline config checks.
AUDITPRO_PREFLIGHT_CHECK_DB=false

# Opt-in: every AI Visibility scan creates billable model calls.
AUDITPRO_AI_VISIBILITY_ENABLED=false
AUDITPRO_PILOT_AI_ENABLED=false
AUDITPRO_PILOT_AI_BUDGET_EUR=10
AUDITPRO_PILOT_AI_MAX_SCANS=10
AUDITPRO_PILOT_AI_MAX_DOMAINS=5
AUDITPRO_PILOT_AI_SCANS_PER_DOMAIN=2
AUDITPRO_PILOT_AI_RESERVED_EUR_PER_SCAN=1
AUDITPRO_CLAUDE_SEARCH_EUR_PER_REQUEST=0.01
AUDITPRO_PILOT_AI_INPUT_EUR_PER_1K=0.005
AUDITPRO_PILOT_AI_OUTPUT_EUR_PER_1K=0.025
AI_GATEWAY_API_KEY=
AUDITPRO_AI_INPUT_EUR_PER_1K=0.002
AUDITPRO_AI_OUTPUT_EUR_PER_1K=0.006
AUDITPRO_AI_OPENAI_MODEL=openai/gpt-5.6-luna
AUDITPRO_AI_GEMINI_MODEL=google/gemini-3.5-flash-lite
AUDITPRO_AI_PERPLEXITY_MODEL=perplexity/sonar
AUDITPRO_AI_CLAUDE_MODEL=anthropic/claude-sonnet-4.6
